{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bengkel",
	"main": "src/index.js",
	"compatibility_date": "2026-07-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/auth/*",
			"/admin/*",
			"/health",
			"/dashboard",
			"/files/*"
		]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"PROJECT_DISPLAY_NAME": "Irwan Motor",
		"AUTH_SERVICE_KEY": "irwanmotor-auth",
		"AUTH_SERVICE_NAME": "Irwan Motor Auth",
		"ACCESS_TOKEN_TTL_SECONDS": "900",
		"REFRESH_TOKEN_TTL_DAYS": "30",
		"OTP_TTL_SECONDS": "300",
		"OTP_MAX_ATTEMPTS": "5",
		"OTP_RESEND_COOLDOWN_SECONDS": "60",
		"AUTH_ISSUER": "https://bengkel.irwanmotor.workers.dev",
		"AUTH_AUDIENCE": "irwanmotor-services",
		"GOWA_API_BASE": "https://gowa1.punya.top",
		"PASSWORD_PBKDF2_ITERATIONS": "100000",
		"ENABLE_ADMIN_SEED": "false",
		"ENABLE_DIRECT_OTP_FALLBACK": "true",
		"PERMISSION_CACHE_TTL_SECONDS": "120",
		"SESSION_CACHE_TTL_SECONDS": "60",
		"OTP_MESSAGE_TEMPLATE": "Kode OTP Irwan Motor Anda: {{otp}}. Berlaku {{ttl_minutes}} menit. Jangan berikan kode ini kepada siapa pun.",
		"CORS_ORIGINS": "*"
	},
	"secrets": {
		"required": [
			"JWT_SECRET",
			"REFRESH_TOKEN_PEPPER",
			"PASSWORD_PEPPER",
			"OTP_PEPPER",
			"ADMIN_API_TOKEN",
			"GOWA_API_TOKEN"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "irwanmotor_auth_core",
			"database_id": "47ae2ad0-9e5c-4539-bcb6-dd758f3abd06"
		},
		{
			"binding": "AUTH_DB",
			"database_name": "irwanmotor_auth_core",
			"database_id": "47ae2ad0-9e5c-4539-bcb6-dd758f3abd06"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "d0e3f21f860e41ce969b5063c48b69d0"
		},
		{
			"binding": "AUTH_CACHE",
			"id": "d0e3f21f860e41ce969b5063c48b69d0"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "OTP_QUEUE",
				"queue": "irwanmotor-auth-otp"
			},
			{
				"binding": "AUDIT_QUEUE",
				"queue": "irwanmotor-auth-audit"
			},
			{
				"binding": "BACKUP_QUEUE",
				"queue": "irwanmotor-auth-backup"
			}
		],
		"consumers": [
			{
				"queue": "irwanmotor-auth-otp",
				"max_batch_size": 10,
				"max_batch_timeout": 5
			},
			{
				"queue": "irwanmotor-auth-audit",
				"max_batch_size": 25,
				"max_batch_timeout": 10
			},
			{
				"queue": "irwanmotor-auth-backup",
				"max_batch_size": 5,
				"max_batch_timeout": 10
			}
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "AUTH_RATE_LIMITER",
				"class_name": "RateLimitDO"
			},
			{
				"name": "AUTH_SESSION_GUARD",
				"class_name": "SessionGuardDO"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RateLimitDO",
				"SessionGuardDO"
			]
		}
	],
	"triggers": {
		"crons": [
			"0 */6 * * *"
		]
	}
}
